# ============================================================
# La Termitière — Site vitrine production
# ============================================================

# Images Docker GHCR
VITRINE_IMAGE=ghcr.io/marthesok/site-vitrine-de-la-termitiere:latest
CONTACT_PROXY_IMAGE=ghcr.io/marthesok/termitiere-contact-proxy:latest
OAUTH_PROXY_IMAGE=ghcr.io/marthesok/termitiere-oauth-proxy:latest
PUBLISH_PROXY_IMAGE=ghcr.io/marthesok/termitiere-publish-proxy:latest
CHAT_PROXY_IMAGE=ghcr.io/marthesok/termitiere-chat-proxy:latest

# Assistant IA « Termi » (voir chat-proxy/README.md)
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.8-flash
CHAT_RATE_LIMIT_PER_IP=30
CHAT_DAILY_LIMIT=1000

# Contact proxy
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ALLOWED_ORIGIN=https://latermitiere.com

# OAuth GitHub / Decap CMS
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_SCOPE=repo,user

# Publish proxy (offres / promotions, sans compte GitHub - voir publish-proxy/README.md)
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_REPO=martheSOK/site-vitrine-de-la-termitiere
PUBLISH_GITHUB_BRANCH=docker-deployment
PUBLISH_SESSION_SECRET=
PUBLISH_USERS_JSON=
