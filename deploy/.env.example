# ============================================================
# La Termitière — Site vitrine production
# ============================================================

# Images Docker GHCR
VITRINE_IMAGE=ghcr.io/la-termitiere/site-vitrine-de-la-termitiere:latest
CONTACT_PROXY_IMAGE=ghcr.io/la-termitiere/termitiere-contact-proxy:latest
OAUTH_PROXY_IMAGE=ghcr.io/la-termitiere/termitiere-oauth-proxy:latest
PUBLISH_PROXY_IMAGE=ghcr.io/la-termitiere/termitiere-publish-proxy:latest

# Contact proxy
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ALLOWED_ORIGIN=https://latermitiere.com

# OAuth GitHub / Decap CMS
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_SCOPE=repo,user

# Publish proxy (offres / promotions, sans compte GitHub - voir publish-proxy/README.md)
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_REPO=martheSOK/site-vitrine-de-la-termitiere
PUBLISH_GITHUB_BRANCH=docker-deployment
PUBLISH_SESSION_SECRET=
PUBLISH_USERS_JSON=
